# Speech-to-text. Without this, voice input is disabled and the app says so --
# it does not fall back to browser transcription and relabel it as Sarvam.
# Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Speech-to-Text & Alternative Providers (Optional)
ELEVENLABS_API_KEY=

# LLM Providers (Optional)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: point the frontend at a non-proxied backend.
# VITE_API_BASE=http://localhost:8000

